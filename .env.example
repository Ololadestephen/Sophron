# resource server (NO Hedera key — server signs nothing)
HEDERA_NETWORK=hedera:testnet
FACILITATOR_URL=https://api.testnet.blocky402.com
PAY_TO_ACCOUNT=0.0.xxxx
UNTRUSTED_PAY_TO_ACCOUNT=0.0.999999
DATA_PROVIDER=mock
PORT=4021
SERVER_URL=http://localhost:4021
SOPHRON_DASHBOARD_ORIGIN=http://localhost:4321
DATABASE_PATH=./data/sophron.db
# Enables the dashboard reset button. Keep false outside a disposable demo.
SOPHRON_DEMO_MODE=true

# frontend deployment (set PUBLIC_API_BASE_URL to a separately hosted API)
PUBLIC_API_BASE_URL=http://localhost:4021
SITE_URL=http://localhost:4321

# deterministic Sophron policy (amounts are tinybar integer strings)
SOPHRON_MAX_PER_REQUEST_TINYBAR=5000000
SOPHRON_DAILY_LIMIT_TINYBAR=6000000
SOPHRON_APPROVAL_ABOVE_TINYBAR=2000000
SOPHRON_RESERVATION_TTL_SECONDS=900

# client script (scripts/e2e-pay.ts) — the only secret in the project
HEDERA_CLIENT_ID=0.0.yyyy
HEDERA_CLIENT_KEY=
E2E_PRODUCT=risk-report
E2E_ACCOUNT=0.0.1234

# optional: enables LLM service selection; without it the HAK v4 tool runner remains usable
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
